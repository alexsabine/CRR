<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>CRR Flame</title>
<style>
*{margin:0;padding:0}
body{background:#000;display:flex;justify-content:center;align-items:flex-end;height:100vh;overflow:hidden}
canvas{width:160px;height:400px;touch-action:none}
</style>
</head>
<body>
<canvas id="f" width="160" height="400"></canvas>
<script>
// CRR FLAME — every constant from first principles
// C·Ω=1 | Ω(Z₂)=1/π | Ω(SO₂)=1/2π | φ=(1+√5)/2 | Δθ=π/3
// B(r) = exp(r)·(1-r/π), peaks at r = π-1 ≈ 2.14
// Flame width: w ∝ (1-C·Ω)^(1/φ) — remaining capacity before rupture

const cv=document.getElementById('f'),cx=cv.getContext('2d'),
  π=Math.PI, φ=(1+Math.sqrt(5))/2, invφ=1/φ,
  ΩZ=1/π, ΩS=1/(2*π), Δθ=π/3,
  W=160, H=400, img=cx.createImageData(W,H),
  Bn=Math.exp(π-1)/π,  // exact B normalization → peak=1
  rP=π-1;              // beauty peak location

// — DISTURBANCE GRID: buoyancy-advected wake field —
const GW=20, GH=50, grid=new Float32Array(GW*GH*2); // [dx, cool] per cell

// Pointer state
let mx=.5,my=.5,pvx=0,pvy=0,mIn=false;
cv.addEventListener('pointerenter',()=>mIn=true);
cv.addEventListener('pointerleave',()=>{mIn=false;pvx=pvy=0});
cv.addEventListener('pointermove',e=>{
  const r=cv.getBoundingClientRect(),
    nx=(e.clientX-r.left)/r.width,ny=(e.clientY-r.top)/r.height;
  pvx=nx-mx;pvy=ny-my;mx=nx;my=ny;mIn=true;
});

// B(r) = exp(r)·(1-r/π) / Bn — exact peak=1 at r=π-1
function B(r){return r<0?0:Math.min(1,Math.exp(r)*Math.max(0,1-r/π)/Bn)}

// Nested CRR turbulence — 5 φ-scaled octaves, Δθ-rotated, ΩZ-attenuated
function turb(px,py,t){
  let v=0,a=1,f=1;
  for(let g=0;g<5;g++){
    // Drift speeds: 2π² and π² give velocities 2π,π,π,π/2 — all CRR-derived
    const s=f*px+t*(g&1?ΩZ:ΩS)*2*π*π,
          q=f*py+t*(g&1?ΩS:ΩZ)*π*π,
          cs=Math.cos(Δθ*g),sn=Math.sin(Δθ*g),
          u=s*cs-q*sn,w=s*sn+q*cs;
    // Cross-coupling through φ (golden ratio modulation)
    v+=a*(Math.sin(u+Math.sin(w*φ))*Math.cos(w*invφ+Math.sin(u*invφ)));
    a*=ΩZ; f*=φ; // amplitude decays by Ω(Z₂), frequency scales by φ
  }
  return v;
}

// Grid update: advect↑, diffuse laterally, decay, stamp finger
function updateGrid(){
  let i,j;
  // Buoyancy advection: copy from row below (gy+1→gy), blend with inertia, decay
  for(let y=0;y<GH-1;y++)for(let x=0;x<GW;x++){
    i=(y*GW+x)*2; j=((y+1)*GW+x)*2;
    grid[i]=grid[j]*.82+grid[i]*.11;       // dx advects up
    grid[i+1]=grid[j+1]*.82+grid[i+1]*.11; // cool advects up
  }
  // Bottom row: fresh air enters, disturbance decays
  for(let x=0;x<GW;x++){i=((GH-1)*GW+x)*2;grid[i]*=.65;grid[i+1]*=.65}
  // Lateral diffusion (thermal equilibrium recovery)
  for(let y=0;y<GH;y++)for(let x=1;x<GW-1;x++){
    i=(y*GW+x)*2;
    grid[i]=grid[i]*.82+(grid[i-2]+grid[i+2])*.09;
    grid[i+1]=grid[i+1]*.82+(grid[i-2+1]+grid[i+2+1])*.09;
  }
  // Stamp finger as cold obstacle — Gaussian influence kernel
  if(!mIn)return;
  const gfx=mx*(GW-1),gfy=my*(GH-1),R=2.5,R2=R*R;
  for(let dy=-6;dy<=6;dy++){
    const gy=Math.round(gfy+dy); if(gy<0||gy>=GH)continue;
    for(let dx=-6;dx<=6;dx++){
      const gx=Math.round(gfx+dx); if(gx<0||gx>=GW)continue;
      const d2=dx*dx+dy*dy; if(d2>R2*6)continue;
      const p=Math.exp(-d2/(2*R2)),dist=Math.sqrt(d2)+.01;
      i=(gy*GW+gx)*2;
      grid[i]+=dx/dist*p*.45+pvx*(GW-1)*p*.4; // radial deflection + velocity drag
      grid[i+1]=Math.min(1,grid[i+1]+p*.75);   // quenching (cold body heat sink)
    }
  }
}

// Bilinear grid sample → [dx, cool]
function samp(sx,sy){
  const gx=sx*(GW-1),gy=sy*(GH-1),
    x0=Math.max(0,Math.min(GW-2,gx|0)),y0=Math.max(0,Math.min(GH-2,gy|0)),
    fx=gx-x0,fy=gy-y0,
    a=(y0*GW+x0)*2,b=a+2,c=a+GW*2,e=c+2,
    w0=(1-fx)*(1-fy),w1=fx*(1-fy),w2=(1-fx)*fy,w3=fx*fy;
  return[grid[a]*w0+grid[b]*w1+grid[c]*w2+grid[e]*w3,
         grid[a+1]*w0+grid[b+1]*w1+grid[c+1]*w2+grid[e+1]*w3];
}

let t=0;
function render(){
  updateGrid();
  const d=img.data,
    // Z₂ puffing: π-frequency base with φ-harmonic (bistable oscillation)
    p1=Math.sin(t*π)*(1+.2*Math.sin(t*π*φ)),
    p2=.5+.5*Math.sin(t*π*φ+Math.sin(t*π)*.8);

  for(let py=0;py<H;py++){
    const ny=1-py/H,
      // Width from CRR: w ∝ (1-C·Ω)^(1/φ), C·Ω=ny → remaining capacity ^ golden ratio inverse
      w0=.35*Math.pow(Math.max(.001,1-ny),invφ),
      w=w0*(1+.06*p1*ny);

    for(let px=0;px<W;px++){
      const nx=(px/W-.5)*2,i=(py*W+px)*4,
        rad0=Math.abs(nx)/Math.max(.005,w);
      if(rad0>4){d[i]=d[i+1]=d[i+2]=0;d[i+3]=255;continue}

      // Sample disturbance — quadratic height scaling: base anchored, tip free
      const[gdx,gcool]=samp(px/W,py/H),
        h2=ny*ny,
        dx=gdx*.28*h2,
        cool=Math.min(.95,gcool*h2);

      // Displaced flame coordinates
      const dnx=nx-dx,
        dny=Math.max(0,Math.min(.999,ny)),
        dw=.35*Math.pow(Math.max(.001,1-dny),invφ)*(1+.06*p1*dny),
        rad=Math.abs(dnx)/Math.max(.005,dw);

      if(rad>3.5&&cool<.01){d[i]=d[i+1]=d[i+2]=0;d[i+3]=255;continue}

      const tb=turb(dnx*3+Math.sin(dny*5+t*2.5)*.25*dny,(dny+t*2)*3,t),
        er=Math.max(0,rad+tb*.22*dny*(1+dny));

      // Intensity from CRR beauty function
      const radB=B(rP*(1-er*.7)),
        vB=B(rP*(.25+.75*Math.pow(Math.sin(dny*π*.78),1.3)));
      let I=radB*vB*(1+.1*(p2-.5)*dny);
      I*=Math.exp(-er*er/(2*ΩZ));                     // regeneration kernel spatial falloff
      I*=Math.max(0,1-Math.pow(dny,4)*(1.3+tb*.3));   // tip extinction at C·Ω→1
      I*=(1-cool);                                     // finger quenching

      const glow=Math.exp(-er*1.8)*.12*(1-dny)*(1-cool),
        tot=Math.max(0,I+glow),core=Math.max(0,1-er*1.5);

      // Color: CRR beauty → blackbody emission mapping
      const t2=tot*tot,t3=t2*tot;
      let r=tot*1.4+core*.3,
          g=t2*1.8*(.2+core*.8),
          bl=t3*3*core;
      // Blue inner cone: low-coherence pre-combustion zone (C₂ radical emission)
      const blue=(1-dny)*(1-dny)*Math.max(0,1-er*10)*.25;
      bl+=blue*.7; g+=blue*.15;
      r+=Math.exp(-er*er/ΩZ)*.08*(1-dny*.5); // orange fringe glow

      d[i]=Math.min(255,r*255)|0;
      d[i+1]=Math.min(255,g*255)|0;
      d[i+2]=Math.min(255,bl*130)|0;
      d[i+3]=255;
    }
  }
  cx.putImageData(img,0,0);
  t+=.033;
  requestAnimationFrame(render);
}
render();
</script>
</body>
</html>
