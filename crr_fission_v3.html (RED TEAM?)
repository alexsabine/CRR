<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>CRR — FISSION</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Instrument+Serif&family=DM+Mono:wght@300&display=swap');
*{margin:0;box-sizing:border-box}body{background:#000;overflow:hidden}canvas{display:block}
.hud{position:fixed;pointer-events:none;z-index:10;font-family:'DM Mono',monospace}
#hp{top:3vh;left:20px;font-size:9px;letter-spacing:.18em;color:rgba(255,255,255,.3)}
