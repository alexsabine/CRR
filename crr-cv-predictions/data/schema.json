{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://temporalgrammar.ai/schemas/crr-cv-prediction.schema.json",
  "title": "CRR CV prediction row",
  "type": "object",
  "required": [
    "id",
    "system",
    "domain",
    "class",
    "symmetry",
    "phi_G",
    "omega_geo",
    "cv_pred",
    "verdict",
    "physical_justification",
    "class_justification",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier; e.g. paper-001, z2so2-cardio-resp, lie-su4-photonic."
    },
    "system": {
      "type": "string",
      "description": "Physical system being predicted."
    },
    "domain": {
      "type": "string",
      "enum": [
        "cardiac", "respiratory", "neural", "cellular", "developmental",
        "microbial", "circadian", "endocrine", "locomotion", "vocal",
        "gastrointestinal", "ecology", "geology", "climate", "astronomy",
        "chemistry", "engineering", "fluids", "synthetic-biology", "behavioural",
        "quantum", "atomic", "particle", "condensed-matter"
      ]
    },
    "class": {
      "type": "string",
      "enum": ["A", "B", "C"]
    },
    "symmetry": {
      "type": "string",
      "description": "Substrate symmetry label (e.g. Z2, SO(2), Z3, SU(2), SO(3), T2, SU(3), SO(4), U(N))."
    },
    "n": {
      "type": ["integer", "null"],
      "description": "Discrete-phase index where applicable (n=2 for Z2, n=4 for SO(2)≅Z4 paper convention, etc.)"
    },
    "phi_G": {
      "type": "number",
      "description": "Bi-invariant closed-geodesic length of the phase manifold G."
    },
    "omega_geo": {
      "type": "number",
      "description": "1/phi_G."
    },
    "cv_pred": {
      "type": "number",
      "description": "Canonical CRR CV prediction = 1/(2·phi_G)."
    },
    "cv_obs": {
      "type": ["number", "null"],
      "description": "Empirical CV from cited source. Null = pending."
    },
    "ratio": {
      "type": ["number", "null"],
      "description": "cv_obs / cv_pred. Null = pending."
    },
    "verdict": {
      "type": "string",
      "enum": ["MATCH", "SUPPRESSED", "ELEVATED", "PENDING"]
    },
    "physical_justification": {
      "type": "string",
      "description": "1-2 sentence rationale for the symmetry class (Appendix C step 3)."
    },
    "class_justification": {
      "type": "string",
      "description": "1-2 sentence rationale for the A/B/C assignment (Appendix C step 4)."
    },
    "data_extraction": {
      "type": ["string", "null"],
      "description": "How cv_obs was derived from the source (e.g. SD/mean of N samples)."
    },
    "reference": {
      "type": ["string", "null"],
      "description": "First-author year journal vol:page or DOI."
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Special features (asymmetric sub-cycles, regulation mechanism, etc.)."
    },
    "provenance": {
      "type": "string",
      "enum": [
        "paper-appendix-A",
        "z2-on-so2-extension",
        "lie-group-extension",
        "memoryless-pure-z2"
      ]
    }
  },
  "additionalProperties": false
}
